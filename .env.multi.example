# One of these per app on a shared server (see deploy/multi/app/docker-compose.yml).
# APP_NAME and DOMAIN must be different for every app.
APP_NAME=greentek
DOMAIN=catalog.example.com
TZ=America/New_York

# the login cookie name: letters, digits and underscores only, and different for every app on the server
COOKIE_NAME=gt_session_greentek

# what this store shows in the browser tab and header (an admin can change it later in the app)
BRAND_NAME=Greentek Catalog
BRAND_MARK=GT
BRAND_COLOR=

# optional
APP_IMAGE=ascendrachel/michaels-listed-sheet
APP_VERSION=1.0.4
APP_PORT=8000
APP_MEMORY=768m
