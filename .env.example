# Copy this file to .env and edit it. Only DOMAIN is required.

# Your public address. Point an A record at the server first, or use the free IP-based name,
# e.g. 192-3-45-67.sslip.io for the server 192.3.45.67
DOMAIN=192-3-45-67.sslip.io

# Time zone the app stamps its times in (Last Optimization Run, activity log ...)
TZ=America/New_York

# --- optional -------------------------------------------------------------------------------------------------
# Port the app listens on INSIDE its container. Free to change; Caddy is told the same number.
APP_PORT=8000
# Ports Caddy opens on the server. Keep 80 and 443 for automatic HTTPS (the certificate check needs them).
HTTP_PORT=80
HTTPS_PORT=443
# The published image the server runs (from Docker Hub) and which version. Use a version number in production so you can go back.
APP_IMAGE=ascendrachel/michaels-listed-sheet
APP_VERSION=1.0.3
# Memory limit for the app container
APP_MEMORY=768m
# What this store is called in the browser tab and header, its two-letter mark and accent colour (an admin can change
# all of these later in the app: Team tab, "Store name & logo"; what they save there wins over these starting values)
BRAND_NAME=Greentek Catalog
BRAND_MARK=GT
BRAND_COLOR=
# Name of the login cookie. Give every app on the same server a different one.
COOKIE_NAME=gt_session
# Docker project name: a second copy of the app on the same server needs its own (it also names its data volume)
COMPOSE_PROJECT_NAME=greentek
